#!/bin/sh
# The catalogue's commit-msg hook - the same tracked-hooksPath pattern as
# `.githooks/pre-commit`, which records why `pre-commit install` is not the instruction and
# what to check when a hook silently never runs. Runs the commit-msg stage: a Conventional
# Commit subject, so the history stays readable by a tool and not only by a person.
HERE=$(dirname "$0")
exec uv run --frozen python -m pre_commit hook-impl \
	--config=.pre-commit-config.yaml \
	--hook-type=commit-msg \
	--hook-dir "$HERE" \
	-- "$@"
