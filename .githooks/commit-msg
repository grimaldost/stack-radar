#!/bin/sh
# The commit-msg hook - the same tracked-hooksPath pattern as .githooks/pre-commit, which
# records why `pre-commit install` is not the instruction. Runs the hooks that
# .pre-commit-config.yaml declares for the commit-msg stage.
HERE=$(dirname "$0")
exec uv run --frozen python -m pre_commit hook-impl \
	--config=.pre-commit-config.yaml \
	--hook-type=commit-msg \
	--hook-dir "$HERE" \
	-- "$@"
